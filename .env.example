# Classroom Prompt Builder — fulfillment env (promptanatomy.online)
# -------------------------------------------------------------------
# 1. Copy to .env for local webhook testing:  copy .env.example .env
# 2. Production: paste each line into Vercel → promptanatomy.online project
#    → Settings → Environment Variables → Production (never commit .env)
# 3. Webhook URL must be: https://promptanatomy.online/api/stripe-webhook
#    (not promptanatomy.app unless same Vercel project + same Redis)
# -------------------------------------------------------------------

# --- Stripe (live keys for live Payment Links) ---
# Dashboard → Developers → API keys → Secret key
STRIPE_SECRET_KEY=sk_live_REPLACE_ME

# Dashboard → Developers → Webhooks → endpoint promptanatomy.online → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Payment Link → open product/price → Price ID (price_...)
STRIPE_PRICE_BEGINNERS_PDF=price_REPLACE_BEGINNERS
STRIPE_PRICE_ADVANCED_PDF=price_REPLACE_ADVANCED

# --- Upstash Redis (fulfillment + download tokens) ---
# console.upstash.com → your database → REST API → URL + Token
UPSTASH_REDIS_REST_URL=https://REPLACE.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_ME

# --- Signed download links ---
# Generate: openssl rand -base64 48   (or any long random string, 32+ chars)
DOWNLOAD_TOKEN_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# --- Email (Resend) ---
# resend.com → API Keys
RESEND_API_KEY=re_REPLACE_ME

# resend.com → Domains → verified sender (must match verified domain)
FULFILLMENT_FROM_EMAIL=Prompt Anatomy <downloads@promptanatomy.online>

# --- Vercel Blob (recommended for PDF storage) ---
# Vercel → Storage → Create Blob store → Connect to promptanatomy.online project
# Token is auto-added as BLOB_READ_WRITE_TOKEN. Upload PDFs: npm run pdf:export && npm run pdf:upload-blob
BLOB_READ_WRITE_TOKEN=vercel_blob_REPLACE_ME

# --- PDF sources (private Blob URLs from upload script) ---
PDF_BEGINNERS_SOURCE_URL=https://REPLACE.private.blob.vercel-storage.com/paid-pdfs/beginners-guide.pdf
PDF_ADVANCED_SOURCE_URL=https://REPLACE.private.blob.vercel-storage.com/paid-pdfs/advanced-educators-guide.pdf

# Optional: if PDF host requires auth
# PDF_SOURCE_AUTH_TOKEN=
# PDF_SOURCE_AUTH_HEADER=Authorization: Bearer YOUR_TOKEN

# --- Recommended ---
SITE_URL=https://promptanatomy.online

# --- Optional (defaults in code if omitted) ---
# DOWNLOAD_TOKEN_TTL_SECONDS=604800
# IN_PAGE_DOWNLOAD_TOKEN_TTL_SECONDS=900
# FULFILLMENT_STATE_TTL_SECONDS=7776000
